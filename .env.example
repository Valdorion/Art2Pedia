# Client IDs OAuth des providers (variables EXPO_PUBLIC_* inlinées à la build).
# Copier ce fichier en .env et remplir. Ne jamais committer de secret.

# Google Cloud Console > OAuth client (iOS/Android) — redirect: art2dex://
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Microsoft Entra ID > App registration (client public, redirect natif art2dex://)
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=

# Discord Developer Portal > OAuth2 — activer le flag "Public client" pour PKCE sans secret,
# ou renseigner le secret ci-dessous.
EXPO_PUBLIC_DISCORD_CLIENT_ID=
EXPO_PUBLIC_DISCORD_CLIENT_SECRET=

# Twitch Developer Console > redirect: art2dex://
EXPO_PUBLIC_TWITCH_CLIENT_ID=

# Apple : sur iOS, Sign in with Apple est natif (bundle id, aucune variable).
# Sur Android/web, flux web Apple avec Services ID + client secret JWT signé :
EXPO_PUBLIC_APPLE_WEB_CLIENT_ID=
EXPO_PUBLIC_APPLE_CLIENT_SECRET=
